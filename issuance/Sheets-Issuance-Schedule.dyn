    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# [py.Revisions-InProject-Data.py]\r\n# V00-00-2026-01-30t1402p\r\n# encoding: utf-8\r\n# Purpose and IO:\r\n#   Purpose:\r\n#     Collect project Revisions and output a stable, schedule-friendly payload\r\n#     for downstream nodes (shared-param writer / binder / stamper / scheduler).\r\n#\r\n#   IN:\r\n#     None\r\n#\r\n#   OUT:\r\n#     OUT[0]=revisionsData (list[dict]) with keys:\r\n#       - Id (int)\r\n#       - SequenceNumber (int)\r\n#       - RevisionNumber (string)\r\n#       - RevisionDate (string)\r\n#       - Description (string)\r\n\r\nimport clr\r\n\r\n#####################################\r\n## 0000_Revit-Imports-And-Context()\r\n#####################################\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import FilteredElementCollector, Revision\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n#####################################\r\n## 0100_Utilities()\r\n#####################################\r\ndef safe_str(x):\r\n    \"\"\"Defensive string conversion for Revit/Dynamo types.\"\"\"\r\n    try:\r\n        return \"\" if x is None else str(x)\r\n    except:\r\n        return \"\"\r\n\r\ndef safe_int(x, default=0):\r\n    \"\"\"Defensive int conversion.\"\"\"\r\n    try:\r\n        return int(x)\r\n    except:\r\n        return int(default)\r\n\r\n#####################################\r\n## 0200_Get-RevisionsData()\r\n#####################################\r\ndef get_revisions_data(doc_):\r\n    \"\"\"\r\n    Returns list[dict] ordered by SequenceNumber (stable).\r\n    Keys match downstream nodes: Id, SequenceNumber, RevisionNumber, RevisionDate, Description.\r\n    \"\"\"\r\n    items = []\r\n    revs = list(FilteredElementCollector(doc_).OfClass(Revision).ToElements())\r\n\r\n    for r in revs:\r\n        try:\r\n            rid = r.Id.IntegerValue\r\n        except:\r\n            continue\r\n\r\n        try:\r\n            seq = safe_int(getattr(r, \"SequenceNumber\", 10**9), 10**9)\r\n        except:\r\n            seq = 10**9\r\n\r\n        try:\r\n            rev_num = safe_str(getattr(r, \"RevisionNumber\", \"\"))\r\n        except:\r\n            rev_num = \"\"\r\n\r\n        try:\r\n            rev_date = safe_str(getattr(r, \"RevisionDate\", \"\"))\r\n        except:\r\n            rev_date = \"\"\r\n\r\n        try:\r\n            desc = safe_str(getattr(r, \"Description\", \"\"))\r\n        except:\r\n            desc = \"\"\r\n\r\n        items.append({\r\n            \"Id\": rid,\r\n            \"SequenceNumber\": seq,\r\n            \"RevisionNumber\": rev_num,\r\n            \"RevisionDate\": rev_date,\r\n            \"Description\": desc,\r\n        })\r\n\r\n    try:\r\n        items.sort(key=lambda d: safe_int(d.get(\"SequenceNumber\", 10**9), 10**9))\r\n    except:\r\n        pass\r\n\r\n    return items\r\n\r\n#####################################\r\n## 0900_Main()\r\n#####################################\r\nrevisions_data = get_revisions_data(doc)\r\n\r\nOUT = [revisions_data]\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "cc8a08aeefc84df9830399e4e6afac0d",
      "NodeType": "PythonScriptNode",
